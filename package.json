{
  "name": "kodexa-hotel",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "db:push": "pnpm --filter web db:push",
    "db:migrate": "pnpm --filter web db:migrate",
    "db:seed": "pnpm --filter web db:seed",
    "db:studio": "pnpm --filter web db:studio",
    "infra:up": "cd docker && docker compose up -d",
    "infra:up:dev": "cd docker && docker compose -f docker-compose.dev.yml up -d",
    "infra:down": "cd docker && docker compose down",
    "infra:logs": "cd docker && docker compose logs -f",
    "assets:gamedata": "bash tools/download-gamedata.sh",
    "assets:download": "bash tools/download-gamedata.sh",
    "imager:gamedata": "node tools/imager/generate-gamedata.js",
    "imager:build": "docker compose -f docker/docker-compose.yml build imager",
    "imager:up": "docker compose -f docker/docker-compose.yml up -d imager",
    "imager:logs": "docker logs kodexa-imager --tail 50"
  },
  "devDependencies": {
    "turbo": "latest"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@9.0.0"
}
